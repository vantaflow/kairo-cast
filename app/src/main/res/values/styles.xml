<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KairoButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:minWidth">240dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/kairo_text</item>
        <item name="android:background">@drawable/focus_row</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="KairoTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kairo_bg</item>
    </style>
</resources>
